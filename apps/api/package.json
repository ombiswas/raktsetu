{
  "name": "@raktsetu/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:release": "tsx scripts/release-migrate.ts",
    "db:seed": "tsx src/platform/database/seed.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "exp:generate": "tsx src/modules/experiments/cli.ts",
    "exp:run": "tsx src/modules/experiments/runner-cli.ts",
    "smoke": "tsx ../../scripts/smoke-test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "argon2": "^0.41.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.2.1",
    "fastify-type-provider-zod": "^4.0.2",
    "jose": "^5.9.6",
    "pg": "^8.13.3",
    "pg-boss": "^10.1.5",
    "pino": "^9.6.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.30.4",
    "eslint": "^9.20.1",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "testcontainers": "^12.2.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1",
    "vitest": "^3.0.6"
  },
  "overrides": {
    "@fastify/static": "10.1.6"
  }
}
