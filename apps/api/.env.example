# ==============================================================================
# RaktSetu API Environment Configuration (.env)
# ==============================================================================

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# PostgreSQL Connection String (must have PostGIS extension enabled)
# For local Postgres: postgres://postgres:postgrespassword@localhost:5432/raktsetu
# For Neon / Supabase: postgres://username:password@ep-xyz.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/raktsetu

# Security Secrets (Must be at least 32 characters long)
JWT_ACCESS_SECRET=dev-super-secret-jwt-key-minimum-32-chars-long!
JWT_ISSUER=raktsetu-api
COOKIE_SECRET=dev-super-secret-cookie-key-minimum-32-chars!
COOKIE_SAME_SITE=strict

# CORS Origins (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Machine Learning Service Integration
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TOKEN=raktsetu-dev-ml-token-secret-2026

# Matching Engine Configuration
MATCHING_ALGORITHM=hybrid
MATCHING_BATCH_SIZE=5
MATCHING_BATCH_WINDOW_SECONDS=300

# Database Connection Pool Sizing
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000

# Email Delivery (mock logs to console without external network calls)
EMAIL_PROVIDER=mock
# EMAIL_API_KEY=re_123456789

# Web Push (optional in local development)
VAPID_SUBJECT=mailto:admin@raktsetu.internal
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
